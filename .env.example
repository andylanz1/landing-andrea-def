# Email service (Resend) — necessario per il form /api/contact
# 1. Registrati su https://resend.com (free tier: 3000 email/mese)
# 2. Verifica il dominio andrealanzone.it (aggiungi i record DNS che ti danno)
# 3. Crea una API key e incollala qui
# 4. Aggiungi la stessa variabile su Vercel: Project → Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Mittente del form contatti. Deve essere un indirizzo del dominio verificato in Resend.
# Default se non impostato: "Andrea Lanzone <noreply@andrealanzone.it>"
CONTACT_FROM_EMAIL="Andrea Lanzone <noreply@andrealanzone.it>"
